# Build on the VM with its 2 GB swap, or on an existing Docker host.
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS frontend
RUN apk add --no-cache make
RUN npm install --global yarn@1.22.22 --force
WORKDIR /src
COPY frontend ./frontend
COPY static ./static
ENV CYPRESS_INSTALL_BINARY=0
ENV NODE_OPTIONS=--max-old-space-size=1536
RUN cd frontend/email-builder && yarn install --frozen-lockfile && yarn build
RUN mkdir -p frontend/public/static/email-builder && cp -r frontend/email-builder/dist/. frontend/public/static/email-builder/
RUN cd frontend && yarn install --frozen-lockfile && yarn build

# Overlay the tested admin API onto the unchanged cached frontend stage.
# Build with the pre-update API in frontend/src/api/index.js and the patched
# API staged as deploy/lightsail/campaign-api-update.js; restore source afterward.
COPY deploy/lightsail/campaign-api-update.js ./frontend/src/api/index.js
ENV NODE_OPTIONS=--max-old-space-size=1024
RUN cd frontend && yarn build

FROM golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039 AS backend
RUN apk add --no-cache make git
WORKDIR /src
COPY . .
COPY --from=frontend /src/frontend/dist ./frontend/dist
COPY --from=frontend /src/static/public/static/altcha.umd.js ./static/public/static/altcha.umd.js
ARG FORK_COMMIT=unknown
ARG LISTMONK_VERSION=v6.2.0-fork
ENV GOMAXPROCS=1
ENV GOFLAGS=-p=1
RUN go install github.com/knadh/stuffbin/...
RUN CGO_ENABLED=0 go build -o listmonk -ldflags="-s -w -X main.versionString=${LISTMONK_VERSION} -X main.buildString=${LISTMONK_VERSION}-${FORK_COMMIT}" ./cmd
RUN /go/bin/stuffbin -a stuff -in listmonk -out listmonk config.toml.sample schema.sql queries:/queries permissions.json static/public:/public static/email-templates frontend/dist:/admin i18n:/i18n

FROM alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0
RUN apk add --no-cache ca-certificates tzdata shadow su-exec
WORKDIR /listmonk
COPY --from=backend /src/listmonk ./listmonk
COPY config.toml.sample ./config.toml
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
EXPOSE 9000
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["./listmonk", "--config", ""]
